{
  "name": "Medium — paint",
  "short_name": "Medium",
  "description": "Realistic paint in the browser: watercolour, gouache, acrylic, oil impasto and ink, with bristle brushes and a palette knife.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#161618",
  "theme_color": "#161618",
  "categories": ["graphics", "design", "productivity"],
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable"},
    {"src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "file_handlers": [
    {"action": "./", "accept": {"application/x-medium-paint": [".mpaint"]}}
  ]
}
